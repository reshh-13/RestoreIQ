		menu
		{
			space Space
			{
				displayname = "Space"
				icon = "objects-spaceship"

				section Artifact_Registrations
				{
					displayname = "Artifact Registrations"
					icon = "design-window-paragraph"
					form  Artifact_Registration
					{
						icon = "design-window-paragraph"
					}
					report All_Artifact_Registrations
					{
						icon = "tech-desktop"
					}
					report Artifact_Registration_Calendar
					{
						icon = "design-window-paragraph"
					}
				}
				section ZC_App_Preferences
				{
					displayname = "App Preferences"
					icon = "design-app"
					systemcomponent
					{
						type = localization
						displayname = "Language Selection"
						icon = "education-language"
					}
					systemcomponent
					{
						type = connection
						displayname = "Integrations"
						icon = "tech-2-connection"
					}
				}
				section ZC_Approvals
				{
					displayname = "Approvals"
					icon = "ui-2-hourglass"
					systemcomponent
					{
						type = approval
						approval status = pending
						displayname = "Pending Tasks"
						icon = "ui-2-hourglass"
					}
					systemcomponent
					{
						type = approval
						approval status = completed
						displayname = "Completed Tasks"
						icon = "design-todo"
					}
				}
				section SharedAnalytics_Section
				{
					type = shared_user_report_section
					displayname = "Reports"
					icon = "business-chart-bar-33"
				}
				section Damage_Assessments
				{
					displayname = "Damage Assessments"
					icon = "sport-user-balance"
					form  Damage_Assessment
					{
						icon = "sport-user-balance"
					}
					report All_Damage_Assessments
					{
						icon = "tech-desktop"
					}
					report Classify_report
					{
						icon = "sport-user-balance"
					}
				}
				section Restoration_Tasks
				{
					displayname = "Restoration Tasks"
					icon = "business-notes"
					form  Restoration_Task
					{
						icon = "design-todo"
					}
					report All_Restoration_Tasks
					{
						icon = "tech-desktop"
					}
				}
				section Restoration_Histories
				{
					displayname = "Restoration Histories"
					icon = "design-collection"
					form  Restoration_History
					{
						icon = "design-collection"
					}
					report All_Restoration_Histories
					{
						icon = "tech-desktop"
					}
				}
				section Tests
				{
					displayname = "Tests"
					icon = "education-flask"
					form  test
					{
						icon = "education-flask"
					}
					report All_Tests
					{
						icon = "tech-desktop"
					}
				}
				section Dashboard
				{
					displayname = "Dashboard"
					icon = "ui-1-dashboard-half"
					page Dashboard
					{
						icon = "ui-1-dashboard-half"
					}
				}
				section Employee_Registeration
