/*
 * Author       : reshma.s.2024.cse_rajalak80
 * Generated on : 12-Nov-2026 11:25:45
 * Version      : 1.0
 */
 application "RestoreIQ"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Artifact_Registration
		{
			displayname = "Artifact Registration"
			success message = "Artifact Registration Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Artifact_ID
			(
    			type = autonumber
				displayname = "Artifact ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Artifact_Name
			(
    			type = text
				displayname = "Artifact Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Artifact_Type
			(
				type = picklist
				displayname = "Artifact Type"
				maxchar = 100
				values = {"Sculpture","Painting","Manuscript","Pottery","Textile","Metalwork"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Material
			(
				type = picklist
				maxchar = 100
				values = {"Wood","Stone","Metal","Paper","Canvas","Ceramic","Textile"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Historic_pe
			(
    			type = text
				displayname = "Historic Period"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Discovery_Location
			(
    			type = text
				displayname = "Discovery Location"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Artifact_Image
			(
    			type = image
				displayname = "Artifact Image"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Current_Condition
			(
				type = picklist
				displayname = "Current Condition"
				maxchar = 100
				values = {"Normal","Defective","Under Restoration"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Registration_Date
			(
    			type = date
				displayname = "Registration Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Damage_Assessment
		{
			displayname = "Damage Assessment"
			success message = "Damage Assessment Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Assessment_ID
			(
    			type = autonumber
				displayname = "Assessment ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employee_ID
			(
    			type = text
				displayname = "Employee ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employee_Name
			(
    			type = text
				displayname = "Employee Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employee_Email
			(
    			type = email
				displayname = "Employee Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Department
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Artifact_Department
			(
				type = picklist
				displayname = "Artifact Department"
				maxchar = 100
				values = {"Sculpture","Painting","Manuscripts","Pottery","Textile","Metalwork"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Artifact
			(
				type = picklist	
				values  = Artifact_Registration.ID
    			displayformat = [Artifact_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Uploaded_Photograph
			(
    			type = image
				displayname = "Uploaded Photograph"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Classification
			(
    			type = text
				displayname = "AI Classification"
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = ObjectDetection
									modelname = "Classification"
									basefield = Uploaded_Photograph
						)
			)
			Department_Mail
			(
    			type = email
				displayname = "Artifact Department Mail"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Assessment_Date
			(
    			type = datetime
				displayname = "Assessment Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Signature
			(
    			type = signature
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Employee_Notes
			(
    			type = textarea
				displayname = "Employee Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Employee_Registeration
		{
			displayname = "Employee Registeration"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Employee_ID
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employee
			(
    			type = text
				displayname = "Employee Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employee_Mail
			(
    			type = email
				displayname = "Employee Mail"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Employee_Department
			(
    			type = text
				displayname = "Employee Department"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Restoration_History
		{
			displayname = "Restoration History"
			success message = "Restoration History Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			History_ID
			(
    			type = autonumber
				displayname = "History ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Artifact_Name
			(
				type = picklist	
				displayname = "Artifact Name"
				values  = Artifact_Registration.ID
    			displayformat = [Artifact_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Work_Performed
			(
    			type = textarea
				displayname = "Work Performed"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Materials_Used
			(
    			type = textarea
				displayname = "Materials Used"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Before_Photograph
			(
    			type = image
				displayname = "Before Photograph"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			After_Photograph
			(
    			type = image
				displayname = "After Photograph"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Specialist_Remarks
			(
    			type = textarea
				displayname = "Specialist Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Completion_Date
			(
    			type = date
				displayname = "Completion Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Restoration_Task
		{
			displayname = "Restoration Task"
			success message = "Restoration Task Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Task_ID
			(
    			type = autonumber
				displayname = "Task ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Artifact
			(
				type = picklist	
				values  = Artifact_Registration.ID
    			displayformat = [Artifact_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Damage_Assessment
			(
				type = picklist	
				displayname = "Damage Assessment"
				values  = Damage_Assessment.ID
    			displayformat = [Classification]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Priority
			(
				type = picklist
				maxchar = 100
				values = {"Low","Medium","High","Critical"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Task_Description
			(
    			type = textarea
				displayname = "Task Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Task_Status
			(
				type = picklist
				displayname = "Task Status"
				maxchar = 100
				values = {"Pending","Assigned","In Progress","Compleated"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Assigned_Date
			(
    			type = date
				displayname = "Assigned Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Expected_Completion
			(
    			type = date
				displayname = "Expected Completion"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Actual_Completion
			(
    			type = date
				displayname = "Actual Completion"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form test
		{
			success message = "Test Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Test_Name1
			(
    			type = text
				displayname = "Test Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Test_Email
			(
    			type = email
				displayname = "Test Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Artifact_Registrations
		{
			displayName = "All Artifact Registrations"
			show all rows from Artifact_Registration    
			(
				Artifact_ID as "Artifact ID"
				Artifact_Name as "Artifact Name"
				Artifact_Type as "Artifact Type"
				Material
				Historic_pe as "Historic Period"
				Discovery_Location as "Discovery Location"
				Artifact_Image as "Artifact Image"
				Current_Condition as "Current Condition"
				Registration_Date as "Registration Date"
			)

		}
		default list All_Damage_Assessments
		{
			displayName = "All Damage Assessments"
			show all rows from Damage_Assessment    
			(
				Assessment_ID as "Assessment ID"
				Employee_ID as "Employee ID"
				Employee_Name as "Employee Name"
				Employee_Email as "Employee Email"
				Department
				Artifact
				Uploaded_Photograph as "Uploaded Photograph"
				Assessment_Date as "Assessment Date"
				Employee_Notes as "Employee Notes"
				Classification as "AI Classification"
				Department_Mail as "Artifact Department Mail"
				Artifact_Department as "Artifact Department"
				Signature
			)

		}
		default list All_Restoration_Tasks
		{
			displayName = "All Restoration Tasks"
			show all rows from Restoration_Task    
			(
				Task_ID as "Task ID"
				Artifact
				Damage_Assessment as "Damage Assessment"
				Priority
				Task_Description as "Task Description"
				Task_Status as "Task Status"
				Assigned_Date as "Assigned Date"
				Expected_Completion as "Expected Completion"
				Actual_Completion as "Actual Completion"
			)

		}
		default list All_Restoration_Histories
		{
			displayName = "All Restoration Histories"
			show all rows from Restoration_History    
			(
				History_ID as "History ID"
				Work_Performed as "Work Performed"
				Materials_Used as "Materials Used"
				Before_Photograph as "Before Photograph"
				After_Photograph as "After Photograph"
				Specialist_Remarks as "Specialist Remarks"
				Completion_Date as "Completion Date"
				Artifact_Name as "Artifact Name"
			)

		}
		default list All_Tests
		{
			displayName = "All Tests"
			show all rows from test    
			(
				Test_Name1 as "Test Name"
				Test_Email as "Test Email"
			)

		}
		list Classify_report
		{
			displayName = "Classify report"
			show all rows from Damage_Assessment    
			(
				Assessment_ID as "Assessment ID"
				Employee_ID as "Employee ID"
				Employee_Name as "Employee Name"
				Employee_Email as "Employee Email"
				Department
				Artifact_Department as "Artifact Department"
				Artifact
				Uploaded_Photograph as "Uploaded Photograph"
				Classification as "AI Classification"
				Department_Mail as "Artifact Department Mail"
				Assessment_Date as "Assessment Date"
				Signature
				Employee_Notes as "Employee Notes"
			)

			group by
			(
				Classification ascending
			)
		}
		default list Employee_Registeration_Report
		{
			displayName = "Employee Registeration Report"
			show all rows from Employee_Registeration    
			(
				Employee_ID
				Employee as "Employee Name"
				Employee_Mail as "Employee Mail"
				Employee_Department as "Employee Department"
			)

		}
		calendar Artifact_Registration_Calendar
		{
			displayName = "Artifact Registration Calendar."
			show all rows from Artifact_Registration    
			(
				Artifact_ID as "Artifact ID"
				Artifact_Name as "Artifact Name"
				Artifact_Type as "Artifact Type"
				Material
				Historic_pe as "Historic Period"
				Discovery_Location as "Discovery Location"
				Artifact_Image as "Artifact Image"
				Current_Condition as "Current Condition"
				Registration_Date as "Registration Date"
			)

			options
			(
				display field = Artifact_ID
				start date = Registration_Date
			)
		}
	}
	pages
	{
		page Dashboard
		{
			displayname = "Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet()\ncontent\n&lt;%{\n\t%&gt;\n&lt;div style=&quot;\n    font-family: &apos;Segoe UI&apos;, Arial, sans-serif;\n    background: linear-gradient(135deg, #F8F5F2, #EFE7DF);\n    border: 1px solid #D8C8B9;\n    border-radius: 18px;\n    padding: 32px;\n    color: #2D2A26;\n    box-sizing: border-box;\n&quot;&gt;\n\n    &lt;div style=&quot;\n        display: inline-block;\n        background: #E5D7CA;\n        color: #7F5539;\n        padding: 7px 13px;\n        border-radius: 20px;\n        font-size: 11px;\n        font-weight: 700;\n        letter-spacing: 2px;\n        margin-bottom: 18px;\n    &quot;&gt;\n        ARTIFACT PRESERVATION SYSTEM\n    &lt;/div&gt;\n\n    &lt;h1 style=&quot;\n        font-size: 36px;\n        margin: 0 0 12px;\n        color: #7F5539;\n        letter-spacing: -1px;\n    &quot;&gt;\n        Restore&lt;span style=&quot;color:#B08968;&quot;&gt;IQ&lt;/span&gt;\n    &lt;/h1&gt;\n\n    &lt;h2 style=&quot;\n        font-size: 19px;\n        font-weight: 500;\n        margin: 0 0 18px;\n        color: #2D2A26;\n    &quot;&gt;\n        Preserving History. Protecting Heritage.\n    &lt;/h2&gt;\n\n    &lt;p style=&quot;\n        font-size: 14px;\n        line-height: 1.8;\n        color: #625A53;\n        max-width: 750px;\n        margin-bottom: 25px;\n    &quot;&gt;\n        RestoreIQ is an intelligent artifact monitoring and damage\n        classification system designed to support museum conservation.\n        It uses AI-assisted image analysis to identify potentially\n        damaged artifacts and streamline the restoration alert process.\n    &lt;/p&gt;\n\n    &lt;div style=&quot;\n        display: flex;\n        flex-wrap: wrap;\n        gap: 12px;\n        margin: 25px 0;\n    &quot;&gt;\n        &lt;div style=&quot;flex:1; min-width:140px; background:rgba(255,255,255,0.65); padding:17px; border-radius:12px; border:1px solid #E1D5CA;&quot;&gt;\n            &lt;div style=&quot;font-size:25px;&quot;&gt;\uD83C\uDFFA&lt;/div&gt;\n            &lt;h3 style=&quot;font-size:14px; color:#7F5539; margin:9px 0 5px;&quot;&gt;Artifact Registry&lt;/h3&gt;\n            &lt;p style=&quot;font-size:12px; line-height:1.5; color:#6D625A; margin:0;&quot;&gt;Centralized artifact records and photographs.&lt;/p&gt;\n        &lt;/div&gt;\n\n        &lt;div style=&quot;flex:1; min-width:140px; background:rgba(255,255,255,0.65); padding:17px; border-radius:12px; border:1px solid #E1D5CA;&quot;&gt;\n            &lt;div style=&quot;font-size:25px;&quot;&gt;\u2726&lt;/div&gt;\n            &lt;h3 style=&quot;font-size:14px; color:#7F5539; margin:9px 0 5px;&quot;&gt;AI Classification&lt;/h3&gt;\n            &lt;p style=&quot;font-size:12px; line-height:1.5; color:#6D625A; margin:0;&quot;&gt;AI-assisted identification of normal and defective artifacts.&lt;/p&gt;\n        &lt;/div&gt;\n\n        &lt;div style=&quot;flex:1; min-width:140px; background:rgba(255,255,255,0.65); padding:17px; border-radius:12px; border:1px solid #E1D5CA;&quot;&gt;\n            &lt;div style=&quot;font-size:25px;&quot;&gt;\u2709&lt;/div&gt;\n            &lt;h3 style=&quot;font-size:14px; color:#7F5539; margin:9px 0 5px;&quot;&gt;Smart Alerts&lt;/h3&gt;\n            &lt;p style=&quot;font-size:12px; line-height:1.5; color:#6D625A; margin:0;&quot;&gt;Department-based email notifications for defective artifacts.&lt;/p&gt;\n        &lt;/div&gt;\n    &lt;/div&gt;\n\n    &lt;div style=&quot;\n        border-left: 4px solid #B08968;\n        padding: 12px 17px;\n        background: rgba(176,137,104,0.10);\n        border-radius: 0 10px 10px 0;\n        margin-top: 24px;\n    &quot;&gt;\n        &lt;p style=&quot;\n            font-size: 14px;\n            font-style: italic;\n            line-height: 1.7;\n            color: #7F5539;\n            margin: 0;\n        &quot;&gt;\n            &quot;Every artifact carries a story. Every restoration\n            protects a piece of history.&quot;\n        &lt;/p&gt;\n    &lt;/div&gt;\n\n    &lt;div style=&quot;\n        margin-top: 25px;\n        padding-top: 15px;\n        border-top: 1px solid #D8C8B9;\n        font-size: 10px;\n        letter-spacing: 1.5px;\n        color: #8A7B70;\n    &quot;&gt;\n        INTELLIGENT CONSERVATION \u00B7 DIGITAL HERITAGE \u00B7 RESTORATION\n    &lt;/div&gt;\n\n&lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Board 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginRight = '7px' \n\n\tcolor = '#FFFFFF'\n\tbgColor = '#2A70E7'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'business-gold'\n\tsize = '24px'\n\tcornerRadius = '26px'\n\ticonType = 'solid'\n/>\n</pc><pc \n\t\tpadding = '5px'\n\n\t\thAlign = 'left'\n>\n\t<pr \n\t>\n\t<pc \n\t\n\t\thAlign = 'left'\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'No of Artifacts'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n\t\thAlign = 'left'\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '2px'\n\tpadding = '0px'\n\tcolor = '#2A70E7'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#2A70E7'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Artifact_Registration.ID.count'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\ttype = 'Column'\n\txtitle = 'Status'\n\tytitle = 'Count'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'left.center'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Damage_Assessment'\n\txfield = 'Classification'\n\tyfields = 'count:Classification'\n/>\n\n</column><column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart 1'\n\n\ttype = 'Pie'\n\txtitle = 'Type of Artifact'\n\tytitle = 'No of artifact'\n\tbgColor = '#FFFFFF'\n\ttheme = '#CC81EC'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Artifact_Registration'\n\txfield = 'Artifact_Type'\n\tyfields = 'count:Artifact_Type'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Classify_report'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<board\n    \n\tbgColor = '#F7F7F7'\n        bgColorType = 'solid'\n\tpadding = '0px'\nelementName='Board 1'\n    layoutType = 'grid'\n        items = '1'\n    appLinkName = 'thisapp'\n    formLinkName = 'Damage_Assessment'\n    rankBy = 'ID'\n    rankOrder = 'highestToLowest'\n    rankAggregate = 'count'\n    limit = '3'\n    groupBy = 'Artifact_Department'\n>\n<boardHeader>\n    <pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '10px'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '15px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'Artifact numbers'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</boardHeader>\n<boardLayout\n                paddingTop = '2px'\n                itemGap = '2px'\n>\n    <pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingLeft = '10px'\n\tpaddingRight = '10px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '0px'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\n\t\twidth = '8%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = 'theme'\n\tsize = '19px'\n\tbold = 'true' \n\ttype = 'boardData'\n\n\n    lineHeight = '26'\n    numOfLines = '1'\n\n\n\n\n\n\t  value = 'rank'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n\t\tpadding = '10px'\n\n\t\twidth = '51%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '15px'\n\tmarginRight = '20px' \n\n\tcolor = '#000000'\n\tbgColor = '#F7F7FB'\n\twidth = '34px'\n\theight = '34px'\n\ttype = 'icon'\n\tvalue = 'ui-1-calendar-grid-58'\n\tsize = '18px'\n\tcornerRadius = '17px'\n\ticonType = 'outline'\n/>\n</pc><pc \n\t\n>\n\t<text \n\n\tcolor = '#000000'\n\tsize = '14px'\n\ttype = 'boardData'\n\n\n    lineHeight = '19'\n    numOfLines = '1'\n\n\n\n\n\n\t  value = 'groupedField'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n\t\tpadding = '10px'\n\n\t\twidth = '41%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginRight = '10px' \n\tcolor = '#000000'\n\tsize = '15px'\n\tbold = 'true' \n\ttype = 'boardData'\n\n\n    lineHeight = '20'\n    numOfLines = '1'\n\n\n\n\n\n\t  value = 'rankAggregate'\n>\n</text>\n\n</pc><pc \n\t\n>\n\t<text \n\n\tmarginRight = '10px' \n\tcolor = '#555555'\n\tsize = '15px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'bugs'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</boardLayout>\n</board>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




		workflow
		{
		form
		{
			Fetch_Employee_Details as "Fetch_Employee_Details"
			{
				type =  form
				form = Damage_Assessment

				record event = on add

				on user input of Employee_ID
				{
					actions 
					{
						custom deluge script
						(
											if(input.Employee_ID != null && input.Employee_ID != "")
										{
											criteria = "(Employee_ID:equals:" + input.Employee_ID.trim() + ")";
											employeeRecord = zoho.crm.searchRecords("Employees",criteria,1,200,Map(),"restoreiq_crm");
											if(employeeRecord != null && employeeRecord.size() > 0)
											{
												emp = employeeRecord.get(0);
												input.Employee_Name = emp.get("Name");
												input.Employee_Email = emp.get("Email");
												input.Department = emp.get("Department");
											}
											else
											{
												alert "Employee ID not found in CRM.";
											}
										}
						)
					}
				}

			}
			test_fill as "test fill"
			{
				type =  form
				form = test

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											mapp = Map();
										mapp1 = Map();
										mapp.put("Name",input.Test_Name1);
										mapp.put("Email",input.Test_Email);
										resp = zoho.crm.createRecord("tests",mapp,mapp1,"zoho_crm_connection41");
										info resp;
						)
					}
				}

			}
			departmail as "departmail"
			{
				type =  form
				form = Damage_Assessment

				record event = on add

				on user input of Artifact_Department
				{
					actions 
					{
						custom deluge script
						(
											if(input.Artifact_Department == "Sculpture")
										{
											input.Department_Mail = "sculpture@example.com";
										}
										else if(input.Artifact_Department == "Painting")
										{
											input.Department_Mail = "painting@example.com";
										}
										else if(input.Artifact_Department == "Manuscripts")
										{
											input.Department_Mail = "manuscripts@example.com";
										}
										else if(input.Artifact_Department == "Pottery")
										{
											input.Department_Mail = "reshma.s.2024.cse@rajalakshmi.edu.in";
										}
										else if(input.Artifact_Department == "Textile")
										{
											input.Department_Mail = "textile@example.com";
										}
										else if(input.Artifact_Department == "Metalwork")
										{
											input.Department_Mail = "metalwork@example.com";
										}
										else
										{
											input.Department_Mail = "";
										}
						)
					}
				}

			}
			Restore_notify as "Restore notify"
			{
				type =  form
				form = Damage_Assessment

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Classification == "Restore")
										{
											sendmail
											[
												from :zoho.adminuserid
												to :input.Department_Mail
												subject :"Restoration Request | " + input.Artifact_Department + " | RestoreIQ"
												message :"<div style='margin:0;padding:35px 12px;background:#f3eee8;font-family:Arial,sans-serif;'>" + "<div style='max-width:620px;margin:auto;background:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #e5d9cd;'>" + "<div style='background:#513d30;padding:30px 35px;text-align:center;'>" + "<p style='margin:0;color:#d8b99b;font-size:11px;letter-spacing:3px;font-weight:bold;'>ARTIFACT CONSERVATION SYSTEM</p>" + "<h1 style='margin:12px 0 5px;color:#ffffff;font-size:32px;letter-spacing:1px;'>Restore<span style='color:#c69b76;'>IQ</span></h1>" + "<p style='margin:0;color:#e5d9cd;font-size:13px;'>Preserving History. Protecting Heritage.</p>" + "</div>" + "<div style='padding:32px 35px;'>" + "<div style='display:inline-block;background:#f8e9df;color:#a34f32;padding:8px 14px;border-radius:20px;font-size:11px;font-weight:bold;letter-spacing:1px;'>RESTORATION REQUIRED</div>" + "<h2 style='color:#513d30;font-size:22px;margin:22px 0 12px;'>A New Restoration Request</h2>" + "<p style='color:#65594f;font-size:14px;line-height:1.8;'>Dear " + input.Artifact_Department + " Department Team,</p>" + "<p style='color:#65594f;font-size:14px;line-height:1.8;'>Our artifact monitoring system has identified an artifact requiring restoration attention. Please review the assessment details below and take the necessary action.</p>" + "<div style='background:#faf7f3;border:1px solid #e9ded3;border-radius:10px;padding:22px;margin:24px 0;'>" + "<p style='margin:0 0 16px;color:#a17b5b;font-size:11px;font-weight:bold;letter-spacing:2px;'>REQUEST DETAILS</p>" + "<table style='width:100%;border-collapse:collapse;font-size:13px;'>" + "<tr><td style='padding:12px 0;color:#887b70;border-bottom:1px solid #e9ded3;'>Department</td><td style='padding:12px 0;color:#513d30;font-weight:bold;text-align:right;border-bottom:1px solid #e9ded3;'>" + input.Artifact_Department + "</td></tr>" + "<tr><td style='padding:12px 0;color:#887b70;border-bottom:1px solid #e9ded3;'>AI Classification</td><td style='padding:12px 0;text-align:right;border-bottom:1px solid #e9ded3;'><span style='background:#f8e9df;color:#a34f32;padding:5px 10px;border-radius:12px;font-weight:bold;'>Restore</span></td></tr>" + "<tr><td style='padding:12px 0;color:#887b70;'>Request Status</td><td style='padding:12px 0;color:#a34f32;font-weight:bold;text-align:right;'>Awaiting Review</td></tr>" + "</table>" + "</div>" + "<p style='color:#65594f;font-size:14px;line-height:1.8;'>Your department's attention is requested to ensure the artifact receives appropriate conservation care.</p>" + "<p style='color:#65594f;font-size:14px;line-height:1.8;'>Thank you for helping preserve our cultural heritage.</p>" + "<p style='color:#513d30;font-size:14px;line-height:1.7;margin-top:28px;'>Regards,<br/><b>RestoreIQ Conservation Team</b></p>" + "</div>" + "<div style='background:#f3eee8;padding:20px;text-align:center;border-top:1px solid #e5d9cd;'>" + "<p style='margin:0;color:#8b7b6e;font-size:11px;letter-spacing:1px;'>INTELLIGENT CONSERVATION · DIGITAL HERITAGE</p>" + "<p style='margin:8px 0 0;color:#a4968a;font-size:10px;'>This is an automated notification generated by RestoreIQ.</p>" + "</div>" + "</div></div>"
											]
										}
						)
					}
				}

			}
			date_migration as "date migration"
			{
				type =  form
				form = Restoration_History

				record event = on add or edit

				on success
				{
				}

			}
			Em_loyees_to_CRM as "Em[loyees to CRM"
			{
				type =  form
				form = Employee_Registeration

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											mapp = Map();
										mapp1 = Map();
										mapp.put("Name",input.Employee);
										mapp.put("Email",input.Employee_Mail);
										mapp.put("Employee_ID",input.Employee_ID);
										resp = zoho.crm.createRecord("Employees",mapp,mapp1,"zoho_crm_connection41");
										info resp;
						)
					}
				}

			}
			Add_Artifact_To_Calendar as "Add_Artifact_To_Calendar"
			{
				type =  form
				form = Artifact_Registration

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Prepare the event date
										eventDate = input.Registration_Date.toString("yyyyMMdd");
										// Prepare calendar date and time
										dateTimeMap = Map();
										dateTimeMap.put("timezone","Asia/Kolkata");
										dateTimeMap.put("start",eventDate + "T100000+0530");
										dateTimeMap.put("end",eventDate + "T101500+0530");
										// Prepare event details
										eventDetails = Map();
										eventDetails.put("estatus","added");
										eventDetails.put("title","New Artifact Registered - " + input.Artifact_Name);
										eventDetails.put("description","Artifact ID: " + input.Artifact_ID + "\nArtifact Name: " + input.Artifact_Name + "\nArtifact Type: " + input.Artifact_Type);
										eventDetails.put("dateandtime",dateTimeMap);
										eventDetails.put("isallday","false");
										// Wrap event details
										eventDataMap = Map();
										eventDataMap.put("eventdata",eventDetails);
										// Create event in Zoho Calendar
										calendarResponse = zoho.calendar.createEvent("0a1d9648c8174322bdfe6e13b98e166f",eventDataMap,"zoho_calendar_connection");
										info calendarResponse;
						)
					}
				}

			}
		}






	}
	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}

	customize
	{
		icon
